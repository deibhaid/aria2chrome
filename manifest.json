{
  "manifest_version": 3,
  "name": "Aria2Chrome",
  "version": "1.2.11",
  "description": "Download manager using aria2c with automatic resume, smart retry, and accurate progress tracking",
  "permissions": [
    "storage",
    "downloads",
    "notifications",
    "contextMenus",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["browser-polyfill.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aria2chrome@example.com",
      "strict_min_version": "109.0"
    }
  }
}
